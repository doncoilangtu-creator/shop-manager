# ====== Supabase ======
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ====== Admin ======
# Password cho tài khoản admin@shop.local (đăng nhập lần đầu)
# Used only by `npm run bootstrap-admin` (>=12 chars; the sample value is rejected)
INITIAL_ADMIN_EMAIL=admin@shop.local
INITIAL_ADMIN_PASSWORD=

# ====== App URL ======
# Local: http://localhost:3000
# Production: https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ====== Shop info (DỰ PHÒNG — nguồn chính là Cài đặt → Hồ sơ hộ kinh doanh trong app) ======
SHOP_NAME=Cửa hàng Máy tính ABC
SHOP_TAX_CODE=0123456789
SHOP_ADDRESS=123 Nguyễn Văn A, Q1, TP.HCM
SHOP_PHONE=0901234567
SHOP_EMAIL=shop@example.vn

# ====== Bot (Telegram) ======
# File: bot/.env (tách riêng)

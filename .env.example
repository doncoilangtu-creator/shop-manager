# ====== Supabase ======
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ====== Admin ======
# Password cho tài khoản admin@shop.local (đăng nhập lần đầu)
INITIAL_ADMIN_PASSWORD=ChangeMeToAStrongPassword123!

# ====== App URL ======
# Local: http://localhost:3000
# Production: https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ====== Shop info (hiện trên PDF báo giá) ======
NEXT_PUBLIC_SHOP_NAME=Cửa hàng Máy tính ABC
NEXT_PUBLIC_SHOP_TAX_CODE=0123456789
NEXT_PUBLIC_SHOP_ADDRESS=123 Nguyễn Văn A, Q1, TP.HCM
NEXT_PUBLIC_SHOP_PHONE=0901234567
NEXT_PUBLIC_SHOP_EMAIL=shop@example.vn

# ====== Bot (Telegram) ======
# File: bot/.env (tách riêng)

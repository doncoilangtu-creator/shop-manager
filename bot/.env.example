# Telegram bot (separate process; copy to bot/.env). Uses the SERVICE ROLE key: never expose it to a browser.
TELEGRAM_BOT_TOKEN=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Public URL of the web app (links in bot replies)
APP_URL=http://localhost:3000

# 'polling' (default, local) or 'webhook' (production)
BOT_MODE=polling

# ---- webhook mode only ----
# PORT=3001
# WEBHOOK_PATH=/telegram
# Public https base URL of this bot; the bot calls setWebhook(WEBHOOK_URL + WEBHOOK_PATH) on start
# WEBHOOK_URL=https://your-bot.example.com
# REQUIRED in webhook mode (>= 16 chars): Telegram sends it in X-Telegram-Bot-Api-Secret-Token, other callers get 401
# Generate: openssl rand -hex 24
# WEBHOOK_SECRET=
